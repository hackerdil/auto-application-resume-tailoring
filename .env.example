# Career Agent configuration. Copy to .env and fill in. Never commit .env.
# Values below are defaults or intentionally empty placeholders.

NODE_ENV=development
# Bind address. Anything other than 127.0.0.1/::1 requires an explicit secure remote mode (not in MVP).
HOST=127.0.0.1
WEB_PORT=3000
API_PORT=3001
# 32+ random bytes, base64. Signs the local session cookie and derives approval-token MAC keys.
LOCAL_SESSION_SECRET=
# 32 random bytes, base64. Used only if no OS keychain key is available.
DATA_ENCRYPTION_KEY=
DATABASE_URL=file:./data/career-agent.sqlite
DATA_DIR=./data
ARTIFACT_DIR=./artifacts
BROWSER_PROFILE_DIR=./data/browser-profile

# OpenAI (primary orchestrator). Model id is required when enabled; no default is assumed.
OPENAI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_TURNS=8
OPENAI_MAX_COST_USD_PER_RUN=1.00

# Claude (independent reviewer/fallback) via the Claude Agent SDK using your Claude Code login.
# subscription mode consumes your Claude plan limits. Leave CLAUDE_MODEL empty to use the SDK default.
CLAUDE_ENABLED=true
CLAUDE_MODE=subscription
CLAUDE_MODEL=
CLAUDE_WORKING_DIRECTORY=./data/claude-workspace
CLAUDE_MAX_TURNS=6
CLAUDE_MAX_COST_USD_PER_RUN=1.00

# openai | claude | hybrid | compare | auto
DEFAULT_PROVIDER_MODE=hybrid
PROVIDER_TIMEOUT_MS=120000
MAX_PROVIDER_RETRIES=2
MAX_CLAUDE_DELEGATIONS_PER_RUN=2

DISCOVERY_SCHEDULE_ENABLED=false
DISCOVERY_CRON=
ENABLE_WORKABLE=false
JOB_FRESHNESS_DAYS=30
MATCH_SCORE_THRESHOLD=70
MAX_JOBS_SCORED_PER_RUN=50

BROWSER_HEADLESS=false
BROWSER_MAX_STEPS=40
BROWSER_TIMEOUT_MS=600000
APPROVAL_TTL_SECONDS=300
# research-only | prepare | review-each | dry-run. Approvals and submission require review-each.
OPERATING_MODE=review-each
SCREENSHOT_RETENTION_DAYS=7
STORE_REDACTED_SCREENSHOTS=false

STORE_FULL_PROMPTS=false
STORE_FULL_MODEL_OUTPUTS=false
LOG_LEVEL=info
# Live tests make paid/network calls. Keep false except for an explicitly authorized smoke test.
ENABLE_LIVE_AI_TESTS=false
ENABLE_LIVE_SOURCE_TESTS=false
